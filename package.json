{
  "name": "error-navigator",
  "displayName": "File Error Navigator",
  "description": "Shows which error you're on and how many the file has in the status bar, with arrows to jump between them.",
  "version": "0.0.51",
  "publisher": "Finingus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:write": "prettier --write .",
    "check": "bun run typecheck && bun run lint && bun run format:write",
    "package": "bun run check && bun run compile && bunx @vscode/vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/finingus/vscode-error-ext.git"
  },
  "icon": "assets/icon.png",
  "preview": false,
  "galleryBanner": {
    "color": "#de1230",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "errorNav.previous",
        "title": "Previous Error",
        "category": "Error Navigator",
        "icon": "$(arrow-up)"
      },
      {
        "command": "errorNav.next",
        "title": "Next Error",
        "category": "Error Navigator",
        "icon": "$(arrow-down)"
      }
    ],
    "configuration": {
      "title": "Error Navigator",
      "properties": {
        "errorNav.enableKeybindings": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the default keybindings for **Previous Error** (`Ctrl+Alt+PageDown`) and **Next Error** (`Ctrl+Alt+PageUp`). Change the keys in the Keyboard Shortcuts editor by searching for `errorNav`."
        }
      }
    },
    "keybindings": [
      {
        "command": "errorNav.previous",
        "key": "ctrl+alt+pagedown",
        "when": "editorTextFocus && config.errorNav.enableKeybindings"
      },
      {
        "command": "errorNav.next",
        "key": "ctrl+alt+pageup",
        "when": "editorTextFocus && config.errorNav.enableKeybindings"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}